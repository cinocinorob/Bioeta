<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup su cloud (account Google) e trasferimento a un nuovo telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="panels.json" />
        <include domain="sharedpref" path="profile.xml" />
        <include domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="panels.json" />
        <include domain="sharedpref" path="profile.xml" />
        <include domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
